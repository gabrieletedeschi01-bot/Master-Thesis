
%% platoon_cbf_continuous.m
% Continuous-time simulation of a platoon with nominal vs CBF-filtered control
% Integration via ODE45

clear; close all; clc;
%% Parameters
N = 10;                   % number of vehicles (1 leader + N-1 followers)
d_des = 3;              % desired spacing (m)
kp = 1; kv = 2;         % nominal controller gains
acc_max = 10;           % actuator bounds

tau_d = 1.8;             % headway-like parameter in h = D - tau_d * v_f
gamma = 5;             % alpha(h) = gamma * h

tspan=[0:10^(-1):30];               % simulation horizon
x0 = zeros(3*N,1);       % initial state [p1,v1,rho1,...,pN,vN,rhoN]

a=0.5;                   %macro function paramters
b=0.5;
l=1.5;
sum_p=0;
sum_v=0;
sum_u=0;


%% Initial conditions
v0 = 20; % initial speed [m/s]
p0 = 600; %initial position [m]
d_ini=3; %initial inter-vehic dist [m]
dv_ini=2;
for i=1:N
    x0(3*i-2) = p0 - (i-1)*d_ini;
    x0(3*i-1) = v0; % velocity
    x0(3*i)   = 0;           %control state

end

% x0
% h=-(x0(4) - x0(1)) - tau_d*x0(5)
% %h=-(x0(4) - x0(1)- (-d_des)) - tau_d*x0(5)


%% Leader input (function of time)
v_leader_fun = @(t)30;
%% Dynamics with CBF filter using quadprog
function [u_nom, u_star, u_req] = compute_control(t,p,v,rho,N,d_des,kp,kv,tau_d,gamma,acc_max,v_leader_fun,a,b)
    
    d_des=-d_des;
    
    u_nom = zeros(N,1);
    u_star = zeros(N,1);
    u_req = zeros(N,1);


    % --- Leader ---
    kl = 2;
    u_nom(1) = -kl*(v(1) - v_leader_fun(t)); % nominal leader control
    u_nom(1) = min(max(u_nom(1), -acc_max), acc_max); % clip to actuator limits
    u_star(1)=u_nom(1);

    % --- Followers ---
    for i = 2:N
        D = p(i) - p(i-1);   % inter-vehicle distance
        dv = v(i) - v(i-1);  % relative velocity
        du=u_star(i) - u_star(i-1);


        % --- Nominal control ---
        Dvi_CP_dot = -kp * dv;
        Dvi_CP = -kp * (D - d_des);
        u_nom(i) = u_star(i-1) + Dvi_CP_dot - kv*(dv - Dvi_CP) - (D - d_des) - rho(i);
        
        if i==10 && (t>10 && t<15)  %veic=9
            u_nom(i) = u_nom(i)+acc_max;
        end       

      
       
        h = -D - tau_d*dv - ((v(i-1) - v(i))^2)/(2*acc_max);
        
       
        

        % gamma_min=0.5;
        % gamma_max=20;
        % gamma_adapt = gamma_min + (gamma_max) * max(0, -h);
        % alpha_h=gamma_adapt*h;
        alpha_h=gamma*h;

        dh_dv = -tau_d + (v(i)-v(i-1))/acc_max;


        %DEBUG
        % % --- before computing u_req ---
        % % compute terms used in u_req (but do not yet form u_req)
        % term_u_prev = u_star(i-1);
        % term_dv_over_tau = - dv / tau_d;
        % % the dpsi_p and dpsi_v should be computed already
        % % (if not, compute them first)
        % % term_dpsi_p = (a*dpsi_p)/tau_d;
        % % term_dpsi_v = (b*dpsi_v)/tau_d;
        % % term_alpha = (gamma * h) / tau_d;
        % 
        % % Print all components and checks
        % fprintf('DEBUG t=%.6f i=%d: u_prev=%.6g dv=%.6g dpsi_p=%.6g dpsi_v=%.6g psi_p=%.6g psi_v=%.6g h=%.6g\n', ...
        %     t, i, term_u_prev, dv, dpsi_p, dpsi_v, psi_p, psi_v, h);
        % 
        % % Check finite-ness explicitly
        % if ~isfinite(term_u_prev), fprintf('  -> u_prev not finite\n'); end
        % if ~isfinite(dv), fprintf('  -> dv not finite\n'); end
        % if ~isfinite(dpsi_p), fprintf('  -> dpsi_p not finite\n'); end
        % if ~isfinite(dpsi_v), fprintf('  -> dpsi_v not finite\n'); end
        % if ~isfinite(h), fprintf('  -> h not finite\n'); end
        % 
        % % If any non-finite, stop into keyboard so you can inspect workspace
        % if ~(isfinite(term_u_prev) && isfinite(dv) && isfinite(dpsi_p) && isfinite(dpsi_v) && isfinite(h))
        %     warning('Non-finite component before u_req at t=%.6f i=%d', t, i);
        %     keyboard;
        % end


        
        u_req(i) =u_star(i-1) -dv/-dh_dv +  alpha_h/-dh_dv;
        % u_req(i) = min(max(u_req(i), -acc_max), acc_max);

        
        % u_star(i)=min(u_req(i),u_nom(i));
        % u_star(i) = min(max(u_star(i), -acc_max), acc_max);

   




        %  --- QP formulation ---
        % Minimize (1/2)*(u - u_nom)^2 s.t. u <=u_req and actuator limits
        H = 1;       % 1x1 quadratic term
        f = -u_nom(i); % linear term
        A = 1;      % inequality: u <= u_req
        % b = u_req(i);
        b = max(u_req(i), -acc_max);
        lb = -acc_max;
        ub = acc_max;
        options = optimoptions('quadprog','Display','off');
        u_star(i) = quadprog(H,f,A,b,[],[],lb,ub,[],options);

        
        % rho_slack = 100;  % peso della penalizzazione del slack
        % H = [1 0; 0 rho_slack];   % 2x2
        % f = [-u_nom(i); 0];       % linear term
        % % Inequality: u - s <= u_req  => [1 -1] * [u;s] <= u_req
        % A = [1 -1];
        % b = u_req(i);
        % lb = [-acc_max; 0];   % u >= -acc_max, s >= 0
        % ub = [acc_max; Inf];  % u <= acc_max, s <= +Inf
        
        % options = optimoptions('quadprog','Display','off');
        % Solve scalar QP: min 0.5*H*u^2 + f*u  s.t. A*u <= b, lb <= u <= ub
        % sol = quadprog(H,f,A,b,[],[],lb,ub,[],options);
        % u_star(i) = sol(1);


    end
end


   

function [psi_p, psi_v]=macrofz(i,d_des,somma_p,somma_v,p_i,v_i)
    tol = 1e-8;

    media_p=somma_p/(i);  %medie
    media_v=somma_v/(i);
    
    var_p=(p_i-media_p)^2/(i); %varianze
    var_v=(v_i-media_v)^2/(i);
    
    psi_p=sign(media_p+d_des)*sqrt(var_p); %macro function
    psi_v=sign(media_v)*sqrt(var_v);

 

end


                          
function dx = platoon_dyn(t,x,N,d_des,kp,kv,a,b,l,sum_p,sum_v,sum_u,v_leader_fun,tau_d,gamma,acc_max)

    dx = zeros(3*N,1);
    % unpack states
    p = x(1:3:end);
    v = x(2:3:end);
    rho=x(3:3:end);

  


    [u_nom,u_star,u_req] = compute_control(t,p,v,rho, N, d_des, kp, kv, tau_d, gamma, acc_max, v_leader_fun,a,b);
    
    %-----Leader dyn-----%
    dx(1)=v(1);
    dx(2)=u_nom(1);
    u_star(1)=u_nom(1);

    if(t>10 && t<15)
      dx(2)=u_nom(1)+acc_max;
    end

    % followers
    for i=2:N
        D = p(i)-p(i-1);
        dv = v(i)-v(i-1);
        du=u_star(i)-u_star(i-1);

        sum_p=sum_p+D;
        sum_v=sum_v+dv;
        sum_u=sum_u+du;
        [psi_p, psi_v]=macrofz(i-1,d_des,sum_p,sum_v,D,dv);


        dx(3*i-2) = v(i);
        dx(3*i-1) = u_star(i);
        dx(3*i)  = -l*x(3*i)+a*psi_p+b*psi_v;


    end
end

%% Simulation
opts = odeset('RelTol',1e-4,'AbsTol',1e-4,'MaxStep',10^-1);
odefun = @(t,x) platoon_dyn(t,x,N,d_des,kp,kv,a,b,l,sum_p,sum_v,sum_u,v_leader_fun,tau_d,gamma,acc_max);
[t,X] = ode45(odefun,tspan,x0,opts);



% Extract states
p = X(:,1:3:end);
v = X(:,2:3:end);
rho=X(:,3:3:end);



%% Recompute controls at each time step
U_nom = zeros(length(t), N);
U_star = zeros(length(t), N);
U_req =  zeros(length(t), N);




for k = 1:length(t)
    [u_nom, u_star,u_req] = compute_control(t(k), p(k,:)', v(k,:)', rho(k,:)', N, d_des, kp, kv, tau_d, gamma, acc_max, v_leader_fun,a,b);
    U_nom(k,:) = u_nom;
    U_star(k,:) = u_star;
    U_req(k,:)= u_req;
end




dist=zeros(length(t),N);
h=zeros(length(t),N);

