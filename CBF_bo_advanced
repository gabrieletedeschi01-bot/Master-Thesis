%     h(:,i-1)= -dist(:,i-1) - tau_d*dv(:,i-1);
% end
% a1=1;
% b1=1;

for k = 1:length(t)
    for i = 2:N
        D = p(k,i) - p(k,i-1);
        dist(k,i-1) = D;
        dv(k,i-1) = v(k, i) - v(k, i-1);
        h(k,i-1) = -D - tau_d*dv(k,i-1) - ((v(k,i-1) - v(k,i))^2)/(2*acc_max);

    end
end





